# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
AI_API_KEY=your-api-key-here
# Base URL of an OpenAI-compatible provider (Coarena / AgentRouter / OpenAI).
# Example shapes (replace with the real endpoint):
#   https://<coarena-agentrouter-host>/v1
#   https://api.openai.com/v1
AI_BASE_URL=https://your-provider-endpoint.example.com/v1
# The model identifier served by that endpoint (see check_models.py).
AI_MODEL=your-model-name
