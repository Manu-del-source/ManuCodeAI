# Copy this file to .env and fill in real values. Never commit .env.
AI_API_KEY=your-ai-provider-api-key
AI_BASE_URL=https://your-provider-endpoint.example.com/v1
AI_MODEL=your-model-name

# Licensing API
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
MANUCODEAI_LICENSING_API_URL=https://YOUR-LICENSING-SERVICE.onrender.com

# Clerk - configure a public OAuth application with Device Authorization Grant enabled.
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_FRONTEND_API_URL=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_OAUTH_CLIENT_ID=YOUR_PUBLIC_OAUTH_CLIENT_ID
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_AUTHORIZED_PARTIES=https://YOUR-LICENSING-SERVICE.onrender.com
MANUCODEAI_ADMIN_EMAILS=kiptooe142@gmail.com

# Paystack - secret key must only exist in the backend environment.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_CALLBACK_URL=https://YOUR-LICENSING-SERVICE.onrender.com/payment/complete
