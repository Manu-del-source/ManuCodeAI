{
  "name": "manucodeai",
  "displayName": "ManuCodeAI Developer",
  "description": "AI coding agent powered by ManuCodeAI",
  "version": "0.4.0",
  "publisher": "manucodeai",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onView:manucodeai.chat"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "package": "npm run compile && npm test"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "manucodeai",
          "title": "ManuCodeAI",
          "icon": "resources/manucodeai.svg"
        }
      ]
    },
    "views": {
      "manucodeai": [
        {
          "id": "manucodeai.chat",
          "name": "AI Coding Assistant",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "manucodeai.newChat",
        "title": "ManuCodeAI: New Chat"
      }
    ],
    "configuration": {
      "title": "ManuCodeAI",
      "properties": {
        "manucodeai.typingSpeed": {
          "type": "string",
          "enum": [
            "slow",
            "normal",
            "fast"
          ],
          "enumDescriptions": [
            "15 characters per second - relaxed, easy to follow.",
            "35 characters per second - the default human-like pace.",
            "70 characters per second - brisk."
          ],
          "default": "normal",
          "scope": "window",
          "markdownDescription": "Speed at which generated code is revealed in the preview editor. This only paces the editor rendering; AI generation is never slowed down. `slow` = 15 chars/s, `normal` = 35 chars/s, `fast` = 70 chars/s."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
}
